{
	"name": "klimson-dashboard",
	"private": false,
	"version": "1.0.5",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
